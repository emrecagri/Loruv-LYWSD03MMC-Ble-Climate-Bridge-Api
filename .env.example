# ============================================================
# Loruv LYWSD03MMC BLE Climate Bridge API
# Örnek yapılandırma
# ============================================================

# ------------------------------------------------------------
# API
# ------------------------------------------------------------

APP_NAME=Loruv LYWSD03MMC BLE Climate Bridge API
APP_VERSION=0.1.0
API_PORT=8765
LOG_LEVEL=INFO


# ------------------------------------------------------------
# BLE KEŞİF
# ------------------------------------------------------------

# Otomatik olarak aranacak cihaz adı.
# MAC listesi kullanılmaz.
BLE_TARGET_DEVICE_NAME=LYWSD03MMC

# Her gerçek okuma gerektiğinde yapılacak BLE tarama süresi.
BLE_SCAN_SECONDS=10

# Bir cihaza bağlanırken maksimum bekleme süresi.
BLE_CONNECT_TIMEOUT_SECONDS=30

# Tek bir GATT karakteristiğini okurken maksimum bekleme süresi.
GATT_READ_TIMEOUT_SECONDS=5

# GATT descriptor değerlerini de okumayı dener.
# true = mümkün olduğunca fazla read-only veri toplar.
READ_GATT_DESCRIPTORS=true


# ------------------------------------------------------------
# CACHE
# ------------------------------------------------------------

# Bu süre içinde yeniden API isteği gelirse
# Bluetooth kullanılmadan RAM cache döndürülür.
CACHE_TTL_SECONDS=60


# ------------------------------------------------------------
# CİHAZ İSİMLERİ
# ------------------------------------------------------------

# Bu liste cihazları filtrelemez.
# Sadece MAC adreslerine özel görünen isim verir.
#
# Format:
# MAC=İsim;MAC=İsim
#
# Örnek:
DEVICE_ALIASES=AA:BB:CC:DD:EE:01=Salon;AA:BB:CC:DD:EE:02=Cati
